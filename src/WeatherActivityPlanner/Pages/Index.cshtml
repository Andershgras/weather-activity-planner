@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-header">
    <p class="eyebrow">Weather planning dashboard</p>
    <h1>Weather Activity Planner</h1>
    <p class="dashboard-intro">
        Plan simple activities with weather context from Open-Meteo.
    </p>
</section>

<section class="dashboard-controls" aria-label="Location selector">
    <form method="get" class="location-form">
        <label asp-for="SelectedLocationId">Location</label>
        <select asp-for="SelectedLocationId" class="form-select">
            @foreach (var location in IndexModel.AvailableLocations)
            {
                <option value="@location.Id">@location.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Update weather</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="dashboard-message" role="status">@Model.StatusMessage</div>
}

<section class="dashboard-grid" aria-label="Dashboard overview">
    <div class="dashboard-panel">
        <h2>Current Weather</h2>
        @if (Model.CurrentWeather is not null)
        {
            <p class="location-name">@Model.CurrentWeather.LocationName</p>
            <dl class="weather-details">
                <div>
                    <dt>Temperature</dt>
                    <dd>@Model.CurrentWeather.TemperatureCelsius.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)&deg;C</dd>
                </div>
                <div>
                    <dt>Wind</dt>
                    <dd>@Model.CurrentWeather.WindSpeedKmh.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) km/h</dd>
                </div>
                <div>
                    <dt>Precipitation</dt>
                    <dd>@Model.CurrentWeather.PrecipitationMm.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) mm</dd>
                </div>
                <div>
                    <dt>Rain</dt>
                    <dd>@(Model.CurrentWeather.HasRain ? "Rain detected" : "No rain detected")</dd>
                </div>
            </dl>
            <p class="weather-updated">Updated @Model.CurrentWeather.ObservedAt.ToString("yyyy-MM-dd HH:mm")</p>
        }
        else
        {
            <p class="weather-error">@Model.WeatherErrorMessage</p>
        }
    </div>
    <div class="dashboard-panel">
        <h2>Activity Plan</h2>
        @if (Model.ActivitySuggestion is not null)
        {
            <p class="suggestion-label @Model.ActivitySuggestion.Severity">@Model.ActivitySuggestion.Title</p>
            <p>@Model.ActivitySuggestion.Description</p>
            <form method="post" asp-page-handler="SavePlan" class="save-plan-form">
                <input type="hidden" asp-for="SelectedLocationId" />
                <button type="submit" class="btn btn-outline-primary">Save plan</button>
            </form>
        }
        else
        {
            <p>Activity suggestions need current weather data.</p>
        }
    </div>
    <div class="dashboard-panel">
        <div class="saved-data-header">
            <div>
                <h2>Saved Data</h2>
                @if (string.IsNullOrWhiteSpace(Model.SavedDataErrorMessage) && !string.IsNullOrWhiteSpace(Model.SavedPlansSummary))
                {
                    <p class="saved-plan-count">@Model.SavedPlansSummary</p>
                }
            </div>
            @if (string.IsNullOrWhiteSpace(Model.SavedDataErrorMessage) && Model.SavedActivityPlans.Count > 0)
            {
                <form method="post" asp-page-handler="ClearPlans" onsubmit="return confirm('Clear all saved activity plans?');">
                    <input type="hidden" asp-for="SelectedLocationId" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Clear all</button>
                </form>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SavedDataErrorMessage))
        {
            <p class="weather-error">@Model.SavedDataErrorMessage</p>
        }
        else if (Model.SavedActivityPlans.Count > 0)
        {
            <ul class="saved-plan-list">
                @foreach (var plan in Model.SavedActivityPlans)
                {
                    <li>
                        <div class="saved-plan-summary">
                            <strong>@plan.SuggestionTitle</strong>
                            <span>@plan.SuggestionDescription</span>
                        </div>
                        <dl class="saved-plan-details">
                            <div>
                                <dt>Saved</dt>
                                <dd>@plan.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                            </div>
                            <div>
                                <dt>Location</dt>
                                <dd>@plan.LocationName</dd>
                            </div>
                            <div>
                                <dt>Weather</dt>
                                <dd>
                                    @plan.TemperatureCelsius.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)&deg;C,
                                    @plan.WindSpeedKmh.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) km/h wind,
                                    @plan.PrecipitationMm.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) mm precipitation
                                </dd>
                            </div>
                        </dl>
                        <div class="saved-plan-actions">
                            <form method="post" asp-page-handler="DeletePlan" class="delete-plan-form" onsubmit="return confirm('Delete this saved activity plan?');">
                                <input type="hidden" name="id" value="@plan.Id" />
                                <input type="hidden" asp-for="SelectedLocationId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Delete saved plan for @plan.LocationName">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No saved activity plans yet.</p>
        }
    </div>
</section>
