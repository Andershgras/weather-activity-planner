@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-header">
    <p class="eyebrow">Weather planning dashboard</p>
    <h1>Weather Activity Planner</h1>
    <p class="dashboard-intro">
        Plan simple activities with weather context from Open-Meteo.
    </p>
</section>

<section class="dashboard-controls" aria-label="Location selector">
    <form method="get" class="location-form">
        <label asp-for="SelectedLocationId">Location</label>
        <select asp-for="SelectedLocationId" class="form-select">
            @foreach (var location in IndexModel.AvailableLocations)
            {
                <option value="@location.Id">@location.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Update weather</button>
    </form>
</section>

<section class="dashboard-grid" aria-label="Dashboard overview">
    <div class="dashboard-panel">
        <h2>Current Weather</h2>
        @if (Model.CurrentWeather is not null)
        {
            <p class="location-name">@Model.CurrentWeather.LocationName</p>
            <dl class="weather-details">
                <div>
                    <dt>Temperature</dt>
                    <dd>@Model.CurrentWeather.TemperatureCelsius.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)&deg;C</dd>
                </div>
                <div>
                    <dt>Wind</dt>
                    <dd>@Model.CurrentWeather.WindSpeedKmh.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) km/h</dd>
                </div>
                <div>
                    <dt>Precipitation</dt>
                    <dd>@Model.CurrentWeather.PrecipitationMm.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) mm</dd>
                </div>
                <div>
                    <dt>Rain</dt>
                    <dd>@(Model.CurrentWeather.HasRain ? "Rain detected" : "No rain detected")</dd>
                </div>
            </dl>
            <p class="weather-updated">Updated @Model.CurrentWeather.ObservedAt.ToString("yyyy-MM-dd HH:mm")</p>
        }
        else
        {
            <p class="weather-error">@Model.WeatherErrorMessage</p>
        }
    </div>
    <div class="dashboard-panel">
        <h2>Activity Plan</h2>
        @if (Model.ActivitySuggestion is not null)
        {
            <p class="suggestion-label @Model.ActivitySuggestion.Severity">@Model.ActivitySuggestion.Title</p>
            <p>@Model.ActivitySuggestion.Description</p>
        }
        else
        {
            <p>Activity suggestions need current weather data.</p>
        }
    </div>
    <div class="dashboard-panel">
        <h2>Saved Data</h2>
        <p>Database-backed favorites or saved plans will be added in a later step.</p>
    </div>
</section>
